<?xml version="1.0" encoding="utf-8"?>
<!--
  A taller cell, where the message gets room and the moods get a line each.

  Every id here also exists in the other two layouts, so the provider binds one
  set of views whatever size it is drawing. Only the avatar's size, the text
  sizes and the line counts change between them.

  The content column and the empty state are both present and exactly one is
  visible. Swapping visibility is something RemoteViews can do; picking a
  different layout at draw time is the provider's job, done before this is
  inflated.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_snapshot_background"
  android:orientation="horizontal"
  android:gravity="center_vertical"
  android:padding="18dp">

  <ImageView
    android:id="@+id/widget_avatar"
    android:layout_width="96dp"
    android:layout_height="96dp"
    android:layout_marginEnd="18dp"
    android:adjustViewBounds="true"
    android:scaleType="fitCenter" />

  <LinearLayout
    android:id="@+id/widget_content"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
      android:id="@+id/widget_cycle_day"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textColor="@color/widget_text_primary"
      android:textSize="19sp"
      android:textStyle="bold"
      android:maxLines="1"
      android:ellipsize="end" />

    <TextView
      android:id="@+id/widget_phase"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="1dp"
      android:textColor="@color/widget_text_secondary"
      android:textSize="14sp"
      android:maxLines="1"
      android:ellipsize="end" />

    <TextView
      android:id="@+id/widget_message"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:textColor="@color/widget_text_body"
      android:textSize="14sp"
      android:maxLines="5"
      android:ellipsize="end" />

    <TextView
      android:id="@+id/widget_moods"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:textColor="@color/widget_text_secondary"
      android:textSize="13sp"
      android:lineSpacingExtra="2dp"
      android:maxLines="3"
      android:ellipsize="end" />
  </LinearLayout>

  <TextView
    android:id="@+id/widget_empty"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:text="@string/widget_snapshot_empty"
    android:textColor="@color/widget_text_secondary"
    android:textSize="15sp"
    android:maxLines="4"
    android:ellipsize="end" />
</LinearLayout>
