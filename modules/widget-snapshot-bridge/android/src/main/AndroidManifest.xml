<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget is declared here rather than in the app's generated manifest.

  `android/` is regenerated by prebuild and is not in git, so anything written
  there is lost whenever prebuild regenerates it. This module is an Android
  library, and its manifest and resources are merged into the app at build time,
  which makes this the one place a receiver can be declared and stay declared.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <receiver
      android:name=".WidgetSnapshotProvider"
      android:label="@string/widget_snapshot_label"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>

      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_snapshot_info" />
    </receiver>
  </application>
</manifest>
