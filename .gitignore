# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# App signing credentials, as `eas credentials` writes them when downloading
# the keystore from EAS for backup.
#
# `*.jks` above already catches the keystore itself. These two do not:
# credentials.json holds the keystore password, the key alias and the key
# password in plain text, which is everything needed to sign a release as this
# app. Losing the keystore means never updating the app again; committing it
# means somebody else can ship as us. The directory is ignored as a whole so a
# future `eas credentials` writing a differently-named file is covered too.
credentials.json
credentials/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Firebase native config. Not used and must not be: the app talks to Firebase
# through the JS SDK, and committing this would switch on Cloud Messaging,
# which the privacy policy says the app does not use. See the README.
google-services.json
GoogleService-Info.plist

# local env files
.env*.local
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# build output of the local native modules, which are source-only in git
modules/*/android/build/
modules/*/android/.cxx/
modules/*/ios/build/

# IDE / OS
.idea/
*.iml
Thumbs.db

# Logs
*.log
